# Campus Voice Configuration
# Copy this file to .env or set environment variables

# Port for Flask application (default 5000)
PORT=5000

# Administrator sign-in password (default: admin123)
ADMIN_PASSWORD=admin123

# Secret session key (leave empty to auto-generate)
# SECRET_KEY=your-random-secret-key-here

# Cookie security (set to 1 if deploying on HTTPS)
COOKIE_SECURE=0

# Flask debug mode (1 for development, 0 for production)
FLASK_DEBUG=0
